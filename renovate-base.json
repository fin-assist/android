{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "FIN-184: a new AndroidX line can pull Compose UI and lifecycle past the Compose BOM, and CI on a PR does not catch it; the stack moves as one PR, checked with a UI tests run",
      "matchPackageNames": [
        "androidx.compose:compose-bom",
        "androidx.activity:**",
        "androidx.core:**",
        "androidx.fragment:**",
        "androidx.hilt:hilt-navigation-compose",
        "androidx.lifecycle:**",
        "androidx.navigation:**"
      ],
      "groupName": "androidx compose stack",
      "separateMajorMinor": false
    },
    {
      "description": "FIN-184: fragment 1.9 pulls Compose UI 1.9 and lifecycle 2.10 past the Compose BOM 2025.03.01; it moves together with the BOM, by hand",
      "matchPackageNames": [
        "androidx.fragment:**"
      ],
      "allowedVersions": "<1.9.0"
    },
    {
      "description": "FIN-211: AndroidX and Compose, including mixed groups, require owner review",
      "matchPackageNames": [
        "androidx.**",
        "org.jetbrains.compose**",
        "org.jetbrains.kotlin.plugin.compose**",
        "org.jetbrains.kotlin:compose-compiler-gradle-plugin"
      ],
      "automerge": false
    },
    {
      "description": "FIN-456: update shared controller action, tests and local source together",
      "matchPackageNames": [
        "fin-assist/go-ci",
        "fin-assist/go-ci/**"
      ],
      "groupName": "FinAssist shared Renovate controller",
      "groupSlug": "finassist-shared-renovate",
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "FIN-456: keep controller action and test source revision together",
      "managerFilePatterns": [
        ".github/workflows/renovate-policy-tests.yml"
      ],
      "matchStrings": [
        "\\bsource-revision:\\s*['\"]?(?<currentDigest>[0-9a-f]{40})['\"]?"
      ],
      "depNameTemplate": "fin-assist/go-ci",
      "packageNameTemplate": "fin-assist/go-ci",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github\\/renovate-source\\.json$/"
      ],
      "matchStrings": [
        "\"revision\"\\s*:\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "fin-assist/go-ci",
      "datasourceTemplate": "github-digest",
      "packageNameTemplate": "fin-assist/go-ci",
      "currentValueTemplate": "main"
    }
  ]
}
