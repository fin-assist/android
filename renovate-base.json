{
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "FIN-504: batch ordinary updates in the weekly window",
      "matchPackageNames": [
        "!androidx.**",
        "!org.jetbrains.compose**",
        "!org.jetbrains.kotlin.plugin.compose**",
        "!org.jetbrains.kotlin:compose-compiler-gradle-plugin"
      ],
      "matchDepNames": [
        "!org.jetbrains.kotlin:kotlin-gradle-plugin",
        "!org.jetbrains.kotlin:kotlin-test",
        "!org.jetbrains.kotlin.android",
        "!org.jetbrains.kotlin.jvm",
        "!org.jetbrains.kotlin.plugin.serialization"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies"
    },
    {
      "description": "FIN-184: a new AndroidX line can pull Compose UI and lifecycle past the Compose BOM, and CI on a PR does not catch it; the stack moves as one PR, checked with a UI tests run",
      "matchPackageNames": [
        "androidx.compose:compose-bom",
        "androidx.activity:**",
        "androidx.core:**",
        "androidx.fragment:**",
        "androidx.hilt:hilt-navigation-compose",
        "androidx.lifecycle:**",
        "androidx.navigation:**"
      ],
      "groupName": "androidx compose stack",
      "separateMajorMinor": false
    },
    {
      "description": "FIN-184: fragment 1.9 pulls Compose UI 1.9 and lifecycle 2.10 past the Compose BOM 2025.03.01; it moves together with the BOM, by hand",
      "matchPackageNames": [
        "androidx.fragment:**"
      ],
      "allowedVersions": "<1.9.0"
    },
    {
      "description": "FIN-211: AndroidX and Compose, including mixed groups, require owner review",
      "matchPackageNames": [
        "androidx.**",
        "org.jetbrains.compose**",
        "org.jetbrains.kotlin.plugin.compose**",
        "org.jetbrains.kotlin:compose-compiler-gradle-plugin"
      ],
      "automerge": false
    },
    {
      "description": "FIN-525: update the shared Kotlin catalog version with the Compose compiler in one manual PR",
      "matchDepNames": [
        "org.jetbrains.kotlin:kotlin-gradle-plugin",
        "org.jetbrains.kotlin:kotlin-test",
        "org.jetbrains.kotlin.android",
        "org.jetbrains.kotlin.jvm",
        "org.jetbrains.kotlin.plugin.serialization",
        "org.jetbrains.kotlin.plugin.compose",
        "org.jetbrains.kotlin:compose-compiler-gradle-plugin"
      ],
      "groupName": "Kotlin Compose compiler",
      "matchJsonata": [
        "$not(isVulnerabilityAlert = true)"
      ],
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "description": "Go compiler and toolchain updates remain manual",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "Go toolchains in reusable workflows and container images remain manual",
      "matchPackageNames": [
        "actions/go-versions",
        "golang",
        "library/golang",
        "docker.io/library/golang",
        "golang/go"
      ],
      "enabled": false
    }
  ]
}
